# ===== 必填 =====
DATABASE_URL=mysql+pymysql://root:root@localhost:3307/code_review?charset=utf8mb4
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# ===== LLM 配置 =====
LLM_PROVIDER=claude
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT=120

# ===== 应用配置 =====
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== GitHub =====
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# ===== Message Bus =====
MESSAGE_BUS_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ===== Docker Compose =====
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=code_review
MYSQL_PORT=3307
REDIS_PORT=6380
API_PORT=8001
