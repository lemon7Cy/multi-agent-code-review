# Anthropic / Claude API (optional; MVP has deterministic local rule agents)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-6-thinking
LLM_TIMEOUT=300

# OpenAI-compatible providers (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
NEWAPI_API_KEY=
NEWAPI_BASE_URL=
NEWAPI_MODEL=codex-mini-latest

# GitHub Webhook (optional for local demo; set in production)
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_API_TIMEOUT=30
GITHUB_COMMENT_MAX_CHARS=60000
GITHUB_RAW_FILE_MAX_CHARS=120000

# Message bus: memory / redis
MESSAGE_BUS_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Docker Compose
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=code_review_multiagent
MYSQL_PORT=3307
REDIS_PORT=6380
API_PORT=8001
